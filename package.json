{
	"name": "mn-sv",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && bun run i18n:compile && svelte-check --tsconfig ./tsconfig.json",
		"fmt": "prettier --write .",
		"lint": "prettier --check .",
		"build:apps": "for p in apps/*; do (cd \"$p\" && bun run build) || exit 1; done",
		"check:apps": "for p in apps/*; do (cd \"$p\" && bun run check) || exit 1; done"
	},
	"devDependencies": {
		"@iconify-json/fluent": "^1.2.62",
		"@iconify-json/lucide": "1.2.149",
		"@inlang/paraglide-js": "3.2.2",
		"@sveltejs/adapter-vercel": "7.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.11",
		"marked": "18.3.0",
		"mermaid": "12.3.0",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"unplugin-icons": "24.0.0",
		"vite": "8.3.5"
	},
	"imports": {
		"#lib/*": "./src/lib/*",
		"#geo/*": "./src/lib/apps/geo/lib/*",
		"#charts/*": "./src/lib/apps/charts/lib/*",
		"#viz/*": "./src/lib/apps/viz/lib/*"
	},
	"workspaces": [
		"apps/*"
	],
	"dependencies": {
		"d3-scale": "^4.0.3",
		"d3-time-format": "^4.1.1",
		"html2canvas-pro": "^2.6.5",
		"leaflet": "^1.9.4",
		"maplibre-gl": "^6.20.0",
		"sharp": "^0.35.5",
		"sveaflet": "^0.1.5",
		"sveltekit-superforms": "^3.1.0",
		"svelteplot": "^0.14.2",
		"valibot": "^1.5.0"
	}
}
