{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": [
			"$app/types",
			"unplugin-icons/types/svelte",
			"vite-plugin-pwa/info",
			"vite-plugin-pwa/client"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": ["src/service-worker.js"]
}
