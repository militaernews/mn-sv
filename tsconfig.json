{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"types": [
			"$app/types",
			"unplugin-icons/types/svelte"
		],
		"paths": {
			"#geo/*": [
				"./src/lib/apps/geo/lib/*"
			],
			"#lib/*": [
				"./src/lib/*"
			],
			"#charts/*": [
				"./src/lib/apps/charts/lib/*"
			]
		}
	},
	"include": [
		"src",
		"vite.config.ts"
	],
	"exclude": [
		"src/service-worker"
	]
}
